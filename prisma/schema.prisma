generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  ALUNO
  PSICOLOGO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  avatar    String?
  idade     Int
  email     String   @unique 
  senha     String
  apelido   String?
  tipo      TipoUsuario @default(ALUNO) 
  
  chatsIniciado Chat[] @relation("ChatUser1")
  chatsRecebido  Chat[] @relation("ChatUser2")
  mensagensEnviadas Mensagem[] @relation("MensagemRemetente")
  
  consulta  Consulta[]
}

model Chat {
  id          Int       @id @default(autoincrement())
  usuario1Id  Int
  usuario2Id  Int
  dataCriacao DateTime  @default(now())
  
  usuario1    Usuario   @relation("ChatUser1", fields: [usuario1Id], references: [id])
  usuario2    Usuario   @relation("ChatUser2", fields: [usuario2Id], references: [id])
  
  mensagens   Mensagem[]
  
  @@unique([usuario1Id, usuario2Id])
}

model Mensagem {
  id          Int      @id @default(autoincrement())
  conteudo    String
  dataEnvio   DateTime @default(now())
  
  remetenteId Int
  remetente   Usuario @relation("MensagemRemetente", fields: [remetenteId], references: [id])
  
  chatId      Int
  chat        Chat    @relation(fields: [chatId], references: [id])
}

model Consulta {
  id      Int   @id @default(autoincrement())
  horario DateTime
  data    DateTime
  flag    String?
  usuario Usuario[]
}